<%- include('partials/head', { pageTitle: post ? 'Edit Post' : 'New Post', active: 'posts' }) %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.6/quill.snow.min.css">

<h1 class="page-title"><%= post ? 'Edit Post' : 'New Post' %></h1>
<p class="page-subtitle"><%= post ? 'Update your story.' : 'Write something new.' %></p>

<div class="editor-layout">
  <div>
    <div class="card">
      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" id="title" value="<%= post ? post.title : '' %>" placeholder="Give your post a title">
      </div>
      <div class="form-group">
        <label for="category">Category</label>
        <select id="category">
          <option value="">Choose a category&hellip;</option>
          <% categories.forEach(function (cat) { %>
            <option value="<%= cat.id %>" <%= post && post.categoryId === cat.id ? 'selected' : '' %>><%= cat.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label for="excerpt">Excerpt</label>
        <textarea id="excerpt" placeholder="A short teaser shown on cards (a sentence or two)"><%= post ? post.excerpt : '' %></textarea>
      </div>
      <div class="form-group">
        <label>Body</label>
        <div id="quill-editor"><%- post ? post.bodyHtml : '' %></div>
      </div>
    </div>
  </div>

  <div>
    <div class="card">
      <div class="form-group">
        <label>Title Font</label>
        <div id="font-picker" class="font-picker"></div>
        <input type="hidden" id="title-font" value="<%= post ? post.titleFont : '' %>">
      </div>
    </div>

    <div class="card">
      <div class="form-group">
        <label>Thumbnail Photo</label>
        <div id="thumb-dropzone" class="dropzone <%= post && post.thumbnail ? 'has-image' : '' %>">
          <% if (post && post.thumbnail) { %>
            <img id="thumb-preview" src="/uploads/<%= post.thumbnail %>">
          <% } else { %>
            <span id="thumb-placeholder-text">Click to upload a photo</span>
            <img id="thumb-preview" style="display:none;">
          <% } %>
        </div>
        <input type="file" id="thumb-input" accept="image/*" style="display:none;">
        <input type="hidden" id="thumbnail-path" value="<%= post ? post.thumbnail : '' %>">
      </div>
    </div>

    <div class="card">
      <div class="form-group">
        <label for="status">Status</label>
        <select id="status">
          <option value="draft" <%= !post || post.status === 'draft' ? 'selected' : '' %>>Draft</option>
          <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
        </select>
        <div class="hint">Drafts are never included when you publish the site.</div>
      </div>
      <button class="btn" id="save-btn" style="width:100%;">Save Post</button>
      <% if (post) { %>
        <a class="btn secondary" style="width:100%; text-align:center; margin-top:10px; box-sizing:border-box;" href="/posts">Back to Posts</a>
      <% } %>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.6/quill.min.js"></script>
<script>
  window.FONTS = <%- JSON.stringify(fonts) %>;
  window.POST_ID = <%- post ? JSON.stringify(post.id) : 'null' %>;
</script>
<script src="/admin-assets/editor.js"></script>

<%- include('partials/tail') %>
