<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer-links">
      <a href="<%= url('/') %>">Home</a>
      <% categories.forEach(function (cat) { %>
        <a href="<%= url('/category/' + cat.slug + '/') %>"><%= cat.name %></a>
      <% }); %>
    </div>
    <div>&copy; <%= new Date().getFullYear() %> <%= site.siteName %></div>
  </div>
</footer>
