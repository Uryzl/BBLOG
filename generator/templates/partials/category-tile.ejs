<a class="category-tile<%= category.imagePath ? '' : ' is-placeholder' %>" href="<%= url('/category/' + category.slug + '/') %>"
  style="<%= category.imagePath ? `background-image:url('${url('/images/' + category.imagePath)}')` : '' %>">
  <span class="category-tile-label"><%= category.name %></span>
</a>
